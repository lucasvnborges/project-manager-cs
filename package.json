{
  "name": "nuxt-app",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "build": "nuxt build",
    "vercel-build": "npm run db:migrate && nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@pinia/nuxt": "^1.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@vercel/blob": "^2.8.0",
    "drizzle-orm": "^0.45.2",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.3.2",
    "@types/node": "^24.13.4",
    "@vue/test-utils": "^2.5.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "happy-dom": "^20.14.3",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
