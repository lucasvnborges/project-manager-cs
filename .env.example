# Postgres connection string (server-only).
# Docker Compose sets this automatically to the local db service.
# Without Docker, use Neon or a local Postgres instance.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projects

# Optional in Docker. When COVER_STORAGE=fs, covers are stored on disk.
# Required on Vercel.
BLOB_READ_WRITE_TOKEN=

# fs = local disk (Docker). Leave unset to use Vercel Blob.
COVER_STORAGE=
